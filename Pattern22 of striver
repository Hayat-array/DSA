#include <iostream>
using namespace std;

void pat22(int n){
    for(int i = 0; i < n; i++){
        for(int s = 0; s < i; s++){
            cout << n-s<< " ";  
        }
        for(int j = 0; j < 2*n - 1 - 2*i; j++){
            cout << n - i << " ";
        }
        for(int s =i; s>=1 ; s--){
            cout << n-s+1<< " "; 
        }
        cout << endl;
    }
     for(int i = n-2; i >=0; i--){
        for(int s = 0; s < i; s++){
            cout << n-s<< " ";  
        }
        for(int j = 0; j < 2*n - 1 - 2*i; j++){
            cout << n - i << " ";
        }
        for(int s =i; s>=1 ; s--){
            cout << n-s+1<< " ";  
        }
        cout << endl;
    }
}

int main() {
    int n = 4;
    patt22(n);
    return 0;
}
